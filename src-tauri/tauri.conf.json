{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Todo",
  "version": "0.9.0",
  "identifier": "com.aiproj.todo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Todo",
        "width": 420,
        "height": 560,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 340,
        "minHeight": 300,
        "alwaysOnTop": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": [
      "tools/项目任务工作台.html",
      "tools/日历.html"
    ]
  }
}
